# Public site origin, no trailing slash (metadataBase, canonical, JSON-LD ids)
NEXT_PUBLIC_SITE_URL=

# Sanity project id (blocking item B-01, user-owned)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset (plan value: production)
NEXT_PUBLIC_SANITY_DATASET=

# Server only: Sanity webhook signature secret for /api/revalidate. Never expose as NEXT_PUBLIC_*
SANITY_REVALIDATE_SECRET=
